filters:
  and:
    - file.inFolder(this.file.folder)
    - file.path != this.file.path
    - note.score
views:
  - type: nui-score-chart
    name: Line
    order:
      - file.name
    sort:
      - property: note.date
        direction: ASC
    dateField: note.date
  - type: nui-score-chart
    name: Bars
    order:
      - file.name
    sort:
      - property: note.date
        direction: ASC
    dateField: note.date
