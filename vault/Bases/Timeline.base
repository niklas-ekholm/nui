filters:
  and:
    - file.inFolder(this.file.folder)
    - file.path != this.file.path
    - note.start
    - note.end
views:
  - type: nui-timeline
    name: Timeline
    order:
      - file.name
    sort:
      - property: start
        direction: ASC
    layout: full
    startField: note.start
    endField: note.end
    projectField: note.project
  - type: nui-timeline
    name: With tasks
    order:
      - file.name
    sort:
      - property: start
        direction: ASC
    layout: full-tasks
    startField: note.start
    endField: note.end
    projectField: note.project
  - type: nui-timeline
    name: Compact
    order:
      - file.name
    sort:
      - property: start
        direction: ASC
    layout: compact
    startField: note.start
    endField: note.end
    projectField: note.project
