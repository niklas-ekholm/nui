filters:
  and:
    - file.inFolder(this.file.folder)
    - file.path != this.file.path
views:
  - type: nui-task-list
    name: Open
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    showCompleted: false
  - type: nui-task-list
    name: All
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    showCompleted: true
