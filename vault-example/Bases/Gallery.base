filters:
  and:
    - file.inFolder(this.file.folder)
    - file.path != this.file.path
    - note.coverimage
views:
  - type: nui-picture-gallery
    name: Picture Gallery
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.coverimage
    imageFit: cover
    imageAspectRatio: 1.4
    cardSize: 140
  - type: nui-card-l
    name: Card L
    order:
      - file.name
      - note.author
      - note.finished
    sort:
      - property: note.finished
        direction: DESC
    image: note.coverimage
    imageFit: cover
    imageAspectRatio: 1.4
    cardSize: 220
  - type: nui-card-s
    name: Card S
    order:
      - file.name
      - note.author
    sort:
      - property: file.name
        direction: ASC
    image: note.coverimage
    imageFit: cover
    imageAspectRatio: 1
    cardSize: 140
