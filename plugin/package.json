{
	"name": "nui",
	"version": "0.1.0",
	"description": "NUI layouts, Bases views, and vault navigation for Obsidian",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck && tsc --noEmit --skipLibCheck -p tsconfig.test.json",
		"test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
		"lint": "eslint src",
		"check": "npm run typecheck && npm run lint && npm run test && node scripts/check-no-personal-paths.mjs && node scripts/check-css-variables.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"bases"
	],
	"author": "Niklas Ekholm",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.10.0",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.0",
		"eslint": "^9.15.0",
		"obsidian": "1.13.1",
		"tslib": "2.4.0",
		"typescript": "5.7.3"
	}
}
