.DS_Store
.cursor/
node_modules/
dist/

# Working notes, not part of the published repository.
RELEASE-PLAN.md

# Obsidian writes these constantly and they carry local layout.
vault-example/.obsidian/workspace*.json
vault-example/.obsidian/graph.json

# The folder-index root hub is named after the vault's own folder, so the one
# created here is called vault-example.md and would be an orphan in a release,
# where the folder is nui-vault-<version>. Obsidian recreates it on first open.
vault-example/vault-example.md
vault-example/vault.md

# Build artifacts copied into the example vault by `npm run dev`.
# data.json beside them is committed on purpose — it is the demo configuration.
vault-example/.obsidian/plugins/nui/main.js
vault-example/.obsidian/plugins/nui/manifest.json
vault-example/.obsidian/plugins/nui/styles.css
