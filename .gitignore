.DS_Store
.cursor/
node_modules/
dist/

# Working notes, not part of the published repository.
RELEASE-PLAN.md

# Obsidian writes these constantly and they carry local layout.
vault/.obsidian/workspace*.json
vault/.obsidian/graph.json

# The folder-index root hub is named after the vault's own folder, so the one
# created here is called vault.md and would be an orphan in a release, where the
# folder is nui-vault-<version>. Obsidian recreates it on first open.
vault/vault.md

# Build artifacts copied into the example vault by `npm run dev`.
# data.json beside them is committed on purpose — it is the demo configuration.
vault/.obsidian/plugins/nui/main.js
vault/.obsidian/plugins/nui/manifest.json
vault/.obsidian/plugins/nui/styles.css
